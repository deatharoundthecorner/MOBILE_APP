<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".ui.EditorActivity">

    <!-- Material 3 AppBarLayout with Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:elevation="4dp"
            app:navigationIcon="@drawable/ic_back"
            app:theme="@style/ThemeOverlay.TextEditor.Toolbar"
            app:popupTheme="@style/ThemeOverlay.TextEditor.PopupMenu">

            <!-- Fixed custom Undo and Redo buttons on the right side of Toolbar -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingEnd="8dp">

                <ImageButton
                    android:id="@+id/btnToolbarUndo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_undo"
                    android:contentDescription="@string/action_undo"
                    android:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btnToolbarRedo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_redo"
                    android:contentDescription="@string/action_redo"
                    android:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btnToolbarSave"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_save"
                    android:contentDescription="@string/action_save"
                    android:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btnToolbarSearch"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_search"
                    android:contentDescription="@string/action_search"
                    android:tint="@android:color/white" />
            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Indeterminate Progress Bar for Loading State -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone"
        android:progressTint="?attr/colorPrimary"
        android:progressBackgroundTint="?attr/colorSurfaceVariant" />

    <!-- Collapsible Search and Replace Panel -->
    <LinearLayout
        android:id="@+id/searchPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="?attr/colorSurfaceVariant"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/searchQuery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/search_hint"
                android:textSize="14sp"
                android:inputType="text"
                android:importantForAutofill="no" />

            <TextView
                android:id="@+id/txtMatchCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="1 of 5" />

            <Button
                android:id="@+id/btnFind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_find"
                android:textSize="12sp"
                style="@style/Widget.Material3.Button.TextButton" />

            <ImageButton
                android:id="@+id/btnFindPrev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_prev"
                android:src="@android:drawable/arrow_up_float" />

            <ImageButton
                android:id="@+id/btnFindNext"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_next"
                android:src="@android:drawable/arrow_down_float" />

            <ImageButton
                android:id="@+id/btnCloseSearch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_close"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <EditText
                android:id="@+id/replaceText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/replace_hint"
                android:textSize="14sp"
                android:inputType="text"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/btnReplace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_replace"
                android:textSize="12sp"
                style="@style/Widget.Material3.Button.TextButton" />

            <Button
                android:id="@+id/btnReplaceAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_replace_all"
                android:textSize="12sp"
                style="@style/Widget.Material3.Button.TextButton" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <CheckBox
                android:id="@+id/cbCaseSensitive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/opt_case_sensitive"
                android:textSize="12sp"
                android:minHeight="0dp"
                android:padding="0dp" />

            <CheckBox
                android:id="@+id/cbWholeWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/opt_whole_word"
                android:textSize="12sp"
                android:minHeight="0dp"
                android:padding="0dp" />

            <CheckBox
                android:id="@+id/cbRegex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/opt_regex"
                android:textSize="12sp"
                android:minHeight="0dp"
                android:padding="0dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable EditText Container with Material 3 Styling -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <EditText
            android:id="@+id/editText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:gravity="top|start"
            android:hint="@string/edit_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.2"
            android:fontFamily="monospace"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textCursorDrawable="@drawable/cursor_drawable"
            android:background="?attr/colorSurface"
            android:importantForAutofill="no"
            tools:ignore="LabelFor" />

    </ScrollView>

</LinearLayout>
